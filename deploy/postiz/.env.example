# Copy to deploy/postiz/.env (git-ignored) and fill in. Never commit the real file.
# Generate the secret once: openssl rand -hex 32
JWT_SECRET=

# Instagram (and Facebook): a Meta for Developers app. See docs.postiz.com/providers/instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok needs a public HTTPS domain for login and media, so it starts on a server later.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube: a Google Cloud OAuth client. See docs.postiz.com/providers/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram and TikTok download each video from a public HTTPS link, which localhost isn't.
# Cloudflare R2 (free tier) serves the uploads publicly. Leave as "local" until it's set up.
STORAGE_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto
